-                else if (parent is DataGridView)
+                else if (parent is DataGridView || parent is Guna2DataGridView)
                     parent.Tag = "grid";
             }
 
             foreach (Control ctrl in parent.Controls)
             {
                 EnsureTags(ctrl);
             }
         }
 
 
